# Public canonical application URL (HTTPS in production)
SITE_URL=http://localhost:3000
# Flutterwave v3 Standard: start with test-mode credentials; never commit real values.
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
# Existing tier IDs mapped to Flutterwave USD plan IDs matching price and interval.
FLW_PAYMENT_PLANS={}
# Example shape: {"starter:month":123,"starter:year":456}
# SMTP notification settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=intelligence@resultscaleai.com

# First-run administrator password; existing admin.json credentials are preserved.
ADMIN_PASSWORD=
